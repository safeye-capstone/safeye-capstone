# VLM 공급자: ollama | gemini
# 기존 로컬 환경을 유지하려면 ollama, Gemini API를 사용하려면 gemini
LN_VLM_PROVIDER=gemini

# 공통 추론 설정
LN_TEMPERATURE=0.1
LN_CONNECT_TIMEOUT=5
LN_READ_TIMEOUT=90
LN_MAX_EDGE=768
LN_JSON_RETRY=1
# 429/503에만 적용하는 지수 백오프: 3초 → 6초 → 12초, 최대 30초
LN_RETRY_DELAY_SEC=3
LN_RETRY_BACKOFF_MAX_SEC=30

# Gemini GenerateContent API
LN_GEMINI_API_KEY=실제 발급받은 api 키로 교체
LN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LN_GEMINI_MODEL=gemini-2.5-flash-lite
LN_GEMINI_MAX_OUTPUT_TOKENS=1200
LN_GEMINI_RESPONSE_MIME_TYPE=application/json

# Ollama를 사용할 때만 필요합니다.
LN_OLLAMA_BASE_URL=http://127.0.0.1:11434
LN_MODEL=qwen2.5vl:7b-q4_K_M
LN_KEEP_ALIVE=30m
LN_NUM_CTX=8192
LN_NUM_PREDICT=400
LN_THINK=false
